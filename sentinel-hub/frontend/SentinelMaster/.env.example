# ─────────────────────────────────────────────────────────────────────────────
# Sentinel Master Hub — environment template
#
# Copy to `.env.local` (development) or `/etc/sentinel-master/hub.env` on Kali.
# NEVER commit a filled-in copy. Generate real secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Dashboard password (login gate). Required.
HUB_DASHBOARD_PASSWORD=

# High-entropy secret used to sign the session cookie. MUST differ from the
# dashboard password. Required — the Hub refuses to start without it.
HUB_SESSION_SECRET=

# Session lifetime in minutes (default 480 = 8 hours).
HUB_SESSION_TTL_MINUTES=480

# Login attempt limit before cooldown, and cooldown length in minutes.
HUB_MAX_ATTEMPTS=5
HUB_LOCKOUT_MINUTES=15

# Directory containing the projects to manage. Defaults to F:\INI KALI LA
# on Windows and /mnt/external_hdd on Linux.
HUB_PROJECTS_ROOT=

# ── GitHub ───────────────────────────────────────────────────────────────────
# Fine-grained personal access token. Needs: repo, read:user, admin:public_key.
GITHUB_TOKEN=
GITHUB_USERNAME=Iamatto01
# Optional: override the API base (GitHub Enterprise).
GITHUB_API_BASE=https://api.github.com

# ── SentinelFame (authoritative production service) ──────────────────────────
FAME_BASE_URL=https://hall-of-fame.sentinelai.studio
# Must match ADMIN_PASSWORD on the Cloudflare Worker. Sent as `x-admin-key`.
FAME_ADMIN_KEY=

# ── Sentinel Autobot (local orchestration helper) ────────────────────────────
AUTOBOT_BASE_URL=http://127.0.0.1:8025
# Must match ADMIN_TOKEN in Sentinel-autobot/.env
AUTOBOT_ADMIN_KEY=

# ── Kali Linux bridge ────────────────────────────────────────────────────────
KALI_HOST=
KALI_PORT=22
KALI_USER=kali
# Prefer key authentication. Set KALI_KEY_FILENAME instead of KALI_PASS.
KALI_KEY_FILENAME=
KALI_PASS=
# Absolute path to a known_hosts file pinned to the Kali host key. Required —
# unknown hosts are rejected.
KALI_KNOWN_HOSTS=
# Remote install directory and PM2 process name.
KALI_REMOTE_DIR=/mnt/external_hdd/Sentinel Master
KALI_PM2_NAME=sentinel-master
# Python interpreter that has `paramiko` installed.
KALI_PYTHON=python3

# ─── OmniRoute gateway (9router) ──────────────────────────────────────────────
# Management API base. Use http://127.0.0.1:20128 when the Hub runs on the same
# host as the container, otherwise the LAN address of that host.
HUB_ROUTER_URL=http://127.0.0.1:20128

# Gateway INITIAL_PASSWORD — used for /api/* management calls only. Never
# rendered in the browser; the Hub logs in server-side and caches the cookie.
HUB_ROUTER_PASSWORD=

# Inference key sent as `Authorization: Bearer <key>` to /v1/*. Shown in the UI
# only as a masked preview.
HUB_ROUTER_KEY=

# Public HTTPS base for the gateway, used in copy-paste client snippets.
HUB_ROUTER_PUBLIC_URL=https://router.sentinelai.studio

# Per-request timeout for gateway management calls (milliseconds).
HUB_ROUTER_TIMEOUT_MS=20000

