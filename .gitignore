# ==========================================
# Dependencies
# ==========================================
node_modules/
**/node_modules/
.pnp
.pnp.js

# ==========================================
# Environment & Sensitive Files
# ==========================================
.env
.env.*
*.env
# Allow example and template configs
!*.env.example
!.env.example
!*.env.template
!.env.template

# ==========================================
# Python
# ==========================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
*.egg-info/

# ==========================================
# Build Outputs & Bundles
# ==========================================
dist/
**/dist/
build/
**/build/
.next/
**/.next/
out/
**/out/
.nuxt/

# ==========================================
# Logs & Caches
# ==========================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
**/.cache/
.eslintcache
.parcel-cache/

# ==========================================
# Database Backups & Temporary DB Files
# ==========================================
database/backups/
**/database/backups/
**/backups/
*.db-journal
*.db-wal
*.db-shm

# ==========================================
# Archives & Large Binary Disk/Firmware Images
# ==========================================
_archives/
**/_archives/
*.img
*.iso
*.cpio
*.apk


# ==========================================
# OS & System Files
# ==========================================
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
