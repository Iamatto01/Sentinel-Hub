# Sentinel CTF Framework — environment template
# Copy to .env and fill in real values. Never commit .env.

# Kali SSH connection (via Cloudflare Tunnel)
KALI_HOST=127.0.0.1
KALI_PORT=2222
KALI_USER=kali
KALI_KEY_PATH=~/.ssh/id_rsa
# Set KALI_TUNNEL_HOSTNAME if you want the framework to auto-start cloudflared
KALI_TUNNEL_HOSTNAME=ssh.sentinelai.studio

# Where challenges live on the Kali box
KALI_CHALLENGE_ROOT=/home/kali/ctf

# Where challenges live on this Windows host (mapped drive or local)
HOST_CHALLENGE_ROOT=F:\INI KALI LA\Sentinel CTF\workspace

# Sentinel Router (OmniRoute) — for AI-assisted analysis
ROUTER_BASE_URL=https://router.sentinelai.studio/v1
ROUTER_API_KEY=

# Flag format regex (override per challenge in notes.toml)
DEFAULT_FLAG_REGEX=flag\{[^}]+\}

# Database
DB_PATH=F:\INI KALI LA\Sentinel CTF\sentinel_ctf.db

# MCP server
MCP_HOST=127.0.0.1
MCP_PORT=8765
